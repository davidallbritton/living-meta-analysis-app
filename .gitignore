# R session / history
.Rhistory
.Rapp.history
.RData
.Ruserdata

# R environment / secrets
.Renviron
.httr-oauth

# RStudio
.Rproj.user/

# shinyapps.io / rsconnect deployment records (contain no secrets, but not
# needed in the source repo; regenerated locally on deploy)
rsconnect/

# Precomputed brms (Bayesian multilevel) fits: ~190 MB, over GitHub's 100 MB
# file limit.  Built locally and shipped only in the shinyapps.io deployment
# (rsconnect bundles from the local folder and does not read .gitignore).
data/defaultPrecalculatedBml*.RDS

# knitr / R Markdown caches
*_cache/
/cache/
*.utf8.md
*.knit.md

# Build artifacts
/*.tar.gz
/*.Rcheck/
*-Ex.R

# macOS
.DS_Store
