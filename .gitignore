# R session / history
.Rhistory
.Rapp.history
.RData
.Ruserdata

# R environment / secrets
.Renviron
.httr-oauth

# RStudio
.Rproj.user/

# shinyapps.io / rsconnect deployment records (contain no secrets, but not
# needed in the source repo; regenerated locally on deploy)
rsconnect/

# Precomputed results built locally and shipped only in the shinyapps.io
# deployment (rsconnect bundles from the local folder and does not read
# .gitignore):
# - brms (Bayesian multilevel) fits: ~116 MB, over GitHub's 100 MB file limit
# - Bayes factor robustness plots: stored ggplot objects only render under the
#   ggplot2 major version that built them (the 2023 file failed under ggplot2 4)
data/defaultPrecalculatedBml*.RDS
data/defaultPrecalculatedPlots.RDS

# knitr / R Markdown caches
*_cache/
/cache/
*.utf8.md
*.knit.md

# Build artifacts
/*.tar.gz
/*.Rcheck/
*-Ex.R

# macOS
.DS_Store
